# --- App ---
APP_NAME=AI-Powered E-Commerce Platform
ENVIRONMENT=development
DEBUG=true

# --- Security ---
SECRET_KEY=change-this-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://ecommerce_user:ecommerce_pass@localhost:5432/ecommerce_db

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI Providers ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
AI_PROVIDER=openai
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-sonnet-4-6
